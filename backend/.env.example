PROJECT_NAME=SecureImage
VERSION=1.0.0
DATABASE_URL=sqlite:///./secureimage.db

# Cryptography & Security
RSA_KEY_SIZE=2048
JWT_SECRET=secureimage-college-demo-secret-key-replace-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Administrator
ADMIN_NAME=Security Administrator
ADMIN_EMAIL=admin@secureimage.local
ADMIN_PASSWORD=Admin@123456

# Storage & Limits
MAX_FILE_SIZE_BYTES=10485760
